# HeyGen API
HEYGEN_API_KEY=your_api_key_here

# Avatar Digital Twin IDs (populated after twin creation)
AVATAR_LOOK_ID=look_XXXX
AVATAR_VOICE_ID=voice_XXXX

# Avatar identity (used in video prompts — stored as GitHub Secrets)
AVATAR_NAME=Presenter Name
BRAND_NAME=Brand Name
BRAND_WEBSITE=https://example.com

# Claude API (for blog-to-video prompt generation)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Drive
GOOGLE_SERVICE_ACCOUNT=path/to/service-account.json
DRIVE_OUTPUT_FOLDER_ID=your_drive_folder_id_here
